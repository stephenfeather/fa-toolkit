<?xml version="1.0"?>
<ruleset name="FA Toolkit - Strict WPCS">
	<description>Strict WordPress Coding Standards with pragmatic loader/CLI handling.</description>

	<!-- CLI args -->
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<!-- What to scan: every PHP file in the repo, including .github/ -->
	<file>.</file>

	<!-- Ignore vendor/build artifacts -->
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>dist/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>
	<exclude-pattern>.claude/*</exclude-pattern>

	<!--
		tests/ is not linted. It is a different dialect from the plugin code:
		PSR-4 filenames and PascalCase classes (which WPCS filename sniffs reject
		and which cannot be renamed without breaking composer.json autoload-dev),
		and snake_case test methods (which PSR-12 rejects). Neither standard fits,
		so no standard is applied. See #55.
	-->
	<exclude-pattern>tests/*</exclude-pattern>

	<!-- Standards -->
	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<!-- Enforce: output must be escaped -->
	<rule ref="WordPress.Security.EscapeOutput"/>

	<!-- Enforce: input must be validated/sanitized, and nonce checks where applicable -->
	<rule ref="WordPress.Security.ValidatedSanitizedInput"/>
	<rule ref="WordPress.Security.NonceVerification"/>

	<!-- Allow direct-access guards in leaf files (still strict elsewhere) -->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.exit">
		<exclude-pattern>*/src/*.php</exclude-pattern>
	</rule>

	<!-- CLI code may legitimately output raw CLI text; keep strict in web paths -->
	<rule ref="WordPress.Security.EscapeOutput.OutputNotEscaped">
		<exclude-pattern>src/CLI/*</exclude-pattern>
	</rule>

	<!--
		Unused-parameter reports are switched off repo-wide (#55). Every one of
		the 16 that fired was a parameter the plugin does not control: WP-CLI
		hands every command handler ( $args, $assoc_args ); WordPress filters
		pass their full argument list whether the callback needs it or not (the
		pwbe_where_clause_* handlers take six); and the Promotions getters follow
		WooCommerce's get_*( $context ) shape. Dropping those parameters would
		change a signature that a caller outside this repo dictates, and a
		per-line ignore on each would say the same thing sixteen times.
	-->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<severity>0</severity>
	</rule>

	<!--
		.github/composer-install-check/ stays IN scope per #56. Only these three
		WordPress-specific sniffs are switched off for it, and only for it.

		verify.php is a standalone CI script. It runs under plain `php`, loads no
		WordPress, and exits before anything WordPress-shaped exists. These three
		sniffs are not "violations we are choosing to tolerate" — they are category
		errors, each asking the script to use an API that is definitionally absent:

		- EscapeOutput          wants esc_html() on a printf to a terminal. There is
		                        no HTML, no browser, and no WordPress to escape with.
		- AlternativeFunctions  wants WP_Filesystem instead of fwrite(). WP_Filesystem
		                        ships with WordPress, which is not loaded.
		- GlobalVariablesOverride wants $argv left alone as a WordPress global. $argv
		                        is PHP's CLI argument array, not a WordPress global.

		Scoped at sniff level rather than at the individual error codes that happen to
		fire today (OutputNotEscaped, file_system_operations_fwrite, Prohibited). The
		ruling is about the sniffs being inapplicable to this file, not about five
		specific lines — pinning to today's error codes would let the next fopen() or
		printf() in the same script re-raise the same category error.

		Everything else stays on. The script is still held to Yoda conditions, naming
		conventions, commenting and the rest, and those violations are still reported.
	-->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>.github/composer-install-check/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>.github/composer-install-check/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>.github/composer-install-check/*</exclude-pattern>
	</rule>
</ruleset>
